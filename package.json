{
  "name": "@xyz-element-plus/form",
  "version": "0.1.0",
  "description": "Schema-driven intelligent forms for Vue 3 and Element Plus",
  "type": "module",
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": ["dist", "types", "README.md", "LICENSE"],
  "sideEffects": ["*.css"],
  "scripts": {
    "dev": "vite --config vite.playground.ts",
    "build": "vite build",
    "test": "npm run build && node tests/smoke.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": ["vue", "element-plus", "form", "schema", "component-library"],
  "author": "Denis Huang",
  "license": "ISC",
  "peerDependencies": {
    "element-plus": ">=2.8.0 <3",
    "vue": ">=3.4.0 <4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "element-plus": "^2.13.0",
    "vite": "^7.3.0",
    "vue": "^3.5.26"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
